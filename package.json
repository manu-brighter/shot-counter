{
  "name": "shot-counter",
  "private": true,
  "type": "module",
  "version": "1.2.0",
  "description": "Shot-Counter — real-time multi-team shot counter (Vue 3 · Express 5 · SQLite), runs as a web app or standalone desktop build.",
  "author": "Manuel Heller",
  "repository": {
    "type": "git",
    "url": "https://github.com/manu-brighter/shot-counter.git"
  },
  "main": "main.cjs",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "electron:dev": "concurrently --kill-others \"vite\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.10",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "sass-embedded": "^1.107.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "uqr": "^0.1.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "ch.manu-brighter.shot-counter",
    "productName": "Shot-Counter",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "server/server.cjs",
      "server/config.cjs",
      "main.cjs"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "Shot-Counter-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Shot-Counter-Portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Shot-Counter.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "manu-brighter",
        "repo": "shot-counter"
      }
    ],
    "npmRebuild": false
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.4"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
